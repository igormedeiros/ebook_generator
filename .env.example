# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_api_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# RAG Knowledge Base Configuration
# Embedding model to use for generating vectors
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dimension of the embedding vectors (must match Supabase vector column)
# text-embedding-3-small: 1536 (default)
# text-embedding-3-large: 3072
# text-embedding-ada-002: 1536
RAG_EMBEDDING_DIM=1536

# Glob pattern for finding markdown files to ingest
RAG_KB_MD_GLOB=kb/**/*.md
